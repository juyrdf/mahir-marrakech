# SECURITY WARNING: Keep this file safe. Do not commit actual secrets to GitHub.

# 1. Server Configuration
PROJECT_NAME="Mahir Marrakech"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://your-app-domain.com"]

# 2. Database (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/mahir_db

# 3. AI Provider (Google Gemini or OpenAI)
GOOGLE_API_KEY=your_google_ai_key_here
# OR
OPENAI_API_KEY=your_openai_key_here

# 4. Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENVIRONMENT=gcp-starter
